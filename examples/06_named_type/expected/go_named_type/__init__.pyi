from typing import ClassVar, Generic, Iterable, Never, Self, SupportsIndex, TypeVar, overload

# A named value type: a real int subclass, passed to Go by value.
class MyNamedNonStructInt(int):
    def __new__(cls, value: int = 0) -> Self: ...
    def unname(self) -> int: ...
    def echo_non_struct_int(self) -> str: ...

def fn_echo_non_struct_int(i: MyNamedNonStructInt) -> str: ...

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

ElemType = TypeVar("ElemType")

class Slice(Ref, Generic[ElemType]):
    # Only a concrete subclass for one element type constructs a Slice.
    def __new__(cls, _handle: Never) -> Slice[ElemType]: ...
    # Not iterable: read everything at once with copy_to_py_list().
    __iter__: ClassVar[None]
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: SupportsIndex) -> ElemType: ...
    @overload
    def __getitem__(self, index: slice) -> Self: ...
    def __setitem__(self, index: SupportsIndex, value: ElemType) -> None: ...
    def clone(self) -> Self: ...
    def copy_to_py_list(self) -> list[ElemType]: ...

class SliceInt(Slice[int]):
    def __new__(cls, values: Iterable[int]) -> Self: ...
    def __init__(self, values: Iterable[int]) -> None: ...

# A named slice type: a distinct type from SliceInt, converted only
# explicitly. Both conversions share the backing array; slice operations keep
# the name.
class MyNamedNonStructSliceInt(Slice[int]):
    # Go's MyNamedNonStructSliceInt(s).
    def __new__(cls, values: SliceInt) -> Self: ...
    def __init__(self, values: SliceInt) -> None: ...
    # Go's []int(si).
    def unname(self) -> SliceInt: ...
    def echo_non_struct_slice_int(self) -> str: ...

def fn_echo_non_struct_slice_int(si: MyNamedNonStructSliceInt) -> str: ...

Target = TypeVar("Target")

# A Go *T, as in 07. The pointer itself never changes; .value reads and
# writes *p. Distinct pointer types are unrelated classes, as in Go.
class Ptr(Ref, Generic[Target]):
    # Only a concrete subclass for one target type constructs a Ptr.
    def __new__(cls, _handle: Never) -> Ptr[Target]: ...
    value: Target

# A struct wrapper is a Go variable of type T. Constructors are keyed like Go
# composite literals; an omitted field keeps its Go zero value. A
# struct-typed field reads as a view into the parent (Go's &s.Field);
# assigning it copies the value in. addr() is Go's &v and shares the struct.
#
# *T is a separate class. Building one from a value copies it, like Go's
# p := new(T); *p = v. Its .value is the variable *p, a view; assigning it
# copies the struct in. It has the same fields and methods as T.
class MyNamedSubStruct(Ref):
    def __new__(cls, *, basic_member_value: int = 0) -> MyNamedSubStruct: ...
    def __init__(self, *, basic_member_value: int = 0) -> None: ...
    def __copy__(self) -> MyNamedSubStruct: ...
    def addr(self) -> PtrMyNamedSubStruct: ...
    basic_member_value: int

class PtrMyNamedSubStruct(Ptr[MyNamedSubStruct]):
    def __new__(cls, value: MyNamedSubStruct) -> Self: ...
    def __init__(self, value: MyNamedSubStruct) -> None: ...
    @classmethod
    def from_value(cls, value: MyNamedSubStruct) -> PtrMyNamedSubStruct: ...
    basic_member_value: int

class MyNamedAnomySubStruct(Ref):
    def __new__(cls, *, basic_member_value_2: int = 0) -> MyNamedAnomySubStruct: ...
    def __init__(self, *, basic_member_value_2: int = 0) -> None: ...
    def __copy__(self) -> MyNamedAnomySubStruct: ...
    def addr(self) -> PtrMyNamedAnomySubStruct: ...
    basic_member_value_2: int

class PtrMyNamedAnomySubStruct(Ptr[MyNamedAnomySubStruct]):
    def __new__(cls, value: MyNamedAnomySubStruct) -> Self: ...
    def __init__(self, value: MyNamedAnomySubStruct) -> None: ...
    @classmethod
    def from_value(cls, value: MyNamedAnomySubStruct) -> PtrMyNamedAnomySubStruct: ...
    basic_member_value_2: int

class MyNamedStruct(Ref):
    def __new__(
        cls,
        *,
        my_named_anomy_sub_struct: MyNamedAnomySubStruct | None = None,
        basic_member_value: int = 0,
        ref_member_value: SliceInt | None = None,
        named_basic_member_value: MyNamedNonStructInt = ...,
        named_ref_member_value: MyNamedSubStruct | None = None,
    ) -> MyNamedStruct: ...
    def __init__(
        self,
        *,
        my_named_anomy_sub_struct: MyNamedAnomySubStruct | None = None,
        basic_member_value: int = 0,
        ref_member_value: SliceInt | None = None,
        named_basic_member_value: MyNamedNonStructInt = ...,
        named_ref_member_value: MyNamedSubStruct | None = None,
    ) -> None: ...
    def __copy__(self) -> MyNamedStruct: ...
    def addr(self) -> PtrMyNamedStruct: ...
    # Embedded field, named after its type.
    my_named_anomy_sub_struct: MyNamedAnomySubStruct
    # Promoted from my_named_anomy_sub_struct.
    basic_member_value_2: int
    basic_member_value: int
    ref_member_value: SliceInt
    named_basic_member_value: MyNamedNonStructInt
    named_ref_member_value: MyNamedSubStruct
    # A variable is addressable: pointer receivers apply to it, as in Go.
    def echo_non_ptr(self) -> str: ...
    def echo_ptr(self) -> str: ...
    # Pointer receiver: modifies this struct.
    def inc_basic_ptr(self) -> None: ...
    # Value receiver: modifies a copy and returns it.
    def inc_basic_non_ptr(self) -> MyNamedStruct: ...

class PtrMyNamedStruct(Ptr[MyNamedStruct]):
    def __new__(cls, value: MyNamedStruct) -> Self: ...
    def __init__(self, value: MyNamedStruct) -> None: ...
    @classmethod
    def from_value(cls, value: MyNamedStruct) -> PtrMyNamedStruct: ...
    my_named_anomy_sub_struct: MyNamedAnomySubStruct
    basic_member_value_2: int
    basic_member_value: int
    ref_member_value: SliceInt
    named_basic_member_value: MyNamedNonStructInt
    named_ref_member_value: MyNamedSubStruct
    def echo_non_ptr(self) -> str: ...
    def echo_ptr(self) -> str: ...
    def inc_basic_ptr(self) -> None: ...
    def inc_basic_non_ptr(self) -> MyNamedStruct: ...

def fn_echo_non_ptr(si: MyNamedStruct) -> str: ...
def ptr_fn_echo_ptr(si: PtrMyNamedStruct) -> str: ...
