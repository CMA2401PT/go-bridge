from typing import Generic, Never, Self, TypeVar

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

Target = TypeVar("Target")

# A Go *T, as in 07. Construction is p := new(T); *p = v. When T is itself a
# pointer, v is copied as a pointer, so both refer to the same target, and
# .value returns a new wrapper for that target. Reading a level that Go set
# to nil raises ValueError.
class Ptr(Ref, Generic[Target]):
    def __new__(cls, _handle: Never) -> Ptr[Target]: ...
    value: Target

class PtrInt(Ptr[int]):
    def __new__(cls, value: int = 0) -> Self: ...
    def __init__(self, value: int = 0) -> None: ...
    @classmethod
    def from_value(cls, value: int) -> PtrInt: ...
    def ptr(self) -> PtrPtrInt: ...

# **int and *int are generated because ***int needs them. A pointer to a
# pointer has no zero-value constructor (Go's zero is nil) and no methods.
class PtrPtrInt(Ptr[PtrInt]):
    def __new__(cls, value: PtrInt) -> Self: ...
    def __init__(self, value: PtrInt) -> None: ...
    @classmethod
    def from_value(cls, value: PtrInt) -> PtrPtrInt: ...
    def ptr(self) -> PtrPtrPtrInt: ...

class PtrPtrPtrInt(Ptr[PtrPtrInt]):
    def __new__(cls, value: PtrPtrInt) -> Self: ...
    def __init__(self, value: PtrPtrInt) -> None: ...
    @classmethod
    def from_value(cls, value: PtrPtrInt) -> PtrPtrPtrInt: ...

# type IntPtr *int: a named pointer. Conversions share the variable; Go
# allows *p but no methods and no new(), so there is no from_value.
class IntPtr(Ptr[int]):
    # Go's IntPtr(p).
    def __new__(cls, p: PtrInt) -> Self: ...
    def __init__(self, p: PtrInt) -> None: ...
    # Go's (*int)(p).
    def unname(self) -> PtrInt: ...

# Counter and Inner are generated because Box fields need them.
class Counter(int):
    def __new__(cls, value: int = 0) -> Self: ...
    def unname(self) -> int: ...
    def echo(self) -> str: ...

# Structs and their pointers, as in 06. Every named struct has a PtrT class
# with the same fields and methods; addr() is Go's &v and shares the struct.
class Inner(Ref):
    def __new__(cls, *, n: int = 0) -> Inner: ...
    def __init__(self, *, n: int = 0) -> None: ...
    def addr(self) -> PtrInner: ...
    n: int

class PtrInner(Ptr[Inner]):
    def __new__(cls, value: Inner) -> Self: ...
    def __init__(self, value: Inner) -> None: ...
    @classmethod
    def from_value(cls, value: Inner) -> PtrInner: ...
    n: int

class Box(Ref):
    def __new__(cls, *, count: Counter = ..., inner: Inner = ...) -> Box: ...
    def __init__(self, *, count: Counter = ..., inner: Inner = ...) -> None: ...
    def addr(self) -> PtrBox: ...
    count: Counter
    inner: Inner
    def echo(self) -> str: ...
    def inc(self) -> None: ...

class PtrBox(Ptr[Box]):
    def __new__(cls, value: Box) -> Self: ...
    def __init__(self, value: Box) -> None: ...
    @classmethod
    def from_value(cls, value: Box) -> PtrBox: ...
    count: Counter
    inner: Inner
    def echo(self) -> str: ...
    def inc(self) -> None: ...
    # A new **Box variable holding this pointer; the struct is shared.
    def ptr(self) -> PtrPtrBox: ...

# **Box: a pointer to a pointer, as for **int. Storing a PtrBox copies the
# pointer, not the struct. Empty method set, as in Go.
class PtrPtrBox(Ptr[PtrBox]):
    def __new__(cls, value: PtrBox) -> Self: ...
    def __init__(self, value: PtrBox) -> None: ...
    @classmethod
    def from_value(cls, value: PtrBox) -> PtrPtrBox: ...

def inc_ppp(p: PtrPtrPtrInt) -> None: ...
def echo_ppp(p: PtrPtrPtrInt) -> str: ...
def retarget(pp: PtrPtrInt, p: PtrInt) -> None: ...
def clear(pp: PtrPtrInt) -> None: ...
def inc_int_ptr(p: IntPtr) -> None: ...
def inc_box_pp(pp: PtrPtrBox) -> None: ...
