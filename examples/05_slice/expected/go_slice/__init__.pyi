from typing import ClassVar, Generic, Iterable, Never, Self, SupportsIndex, TypeVar, overload

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

ElemType = TypeVar("ElemType")

class Slice(Ref, Generic[ElemType]):
    # Only a concrete subclass for one element type constructs a Slice.
    def __new__(cls, _handle: Never) -> Slice[ElemType]: ...
    # Not iterable: read everything at once with copy_to_py_list().
    __iter__: ClassVar[None]
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: SupportsIndex) -> ElemType: ...
    @overload
    def __getitem__(self, index: slice) -> Self: ...
    def __setitem__(self, index: SupportsIndex, value: ElemType) -> None: ...
    def clone(self) -> Self: ...
    def copy_to_py_list(self) -> list[ElemType]: ...

class SliceInt(Slice[int]):
    def __new__(cls, values: Iterable[int]) -> SliceInt: ...
    def __init__(self, values: Iterable[int]) -> None: ...

class SliceSliceInt(Slice[SliceInt]):
    def __new__(cls, values: Iterable[SliceInt]) -> SliceSliceInt: ...
    def __init__(self, values: Iterable[SliceInt]) -> None: ...

def concat_a(a: SliceInt, b: SliceInt) -> SliceInt: ...
def concat_b(a: SliceSliceInt, b: SliceSliceInt) -> SliceSliceInt: ...
