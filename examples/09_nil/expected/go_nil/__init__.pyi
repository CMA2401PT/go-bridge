from typing import Never, Self

# A Go panic, recovered by the adapter. Dereferencing nil is a panic too.
class GoPanic(RuntimeError): ...

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

# nil is a wrapper of the same class, as Go's nil has a static type. None is
# never a Go value. A pointer has no truth value: bool() raises TypeError.
class PtrInt(Ref):
    def __new__(cls, value: int = 0) -> Self: ...
    def __init__(self, value: int = 0) -> None: ...
    @classmethod
    def from_value(cls, value: int) -> PtrInt: ...
    # Go's var p *int.
    @staticmethod
    def nil() -> PtrInt: ...
    # Go's p == nil.
    @property
    def is_nil(self) -> bool: ...
    # Raises GoPanic when nil.
    value: int

# A *List. Pointer-receiver methods also run on nil, as in Go.
class List(Ref):
    def __new__(cls, *, value: int = 0, next: List = ...) -> List: ...
    def __init__(self, *, value: int = 0, next: List = ...) -> None: ...
    @staticmethod
    def nil() -> List: ...
    @property
    def is_nil(self) -> bool: ...
    # Field access on nil raises GoPanic.
    value: int
    # A pointer field: may be nil; reading and writing share the list.
    next: List
    def len(self) -> int: ...
    def push(self, v: int) -> List: ...
    # Pointer receiver that does not check nil: GoPanic from inside Go.
    def first(self) -> int: ...
    # Value receiver: needs *l, so GoPanic on nil.
    def head(self) -> int: ...

def find(l: List, v: int) -> List: ...
def deref(p: PtrInt) -> str: ...
def maybe_int(ok: bool) -> PtrInt: ...
# Raises GoPanic when v <= 0.
def must_positive(v: int) -> int: ...
