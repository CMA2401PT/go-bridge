from typing import Never, Self

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

# nil is a wrapper of the same class, as Go's nil has a static type. None is
# never a Go value. A pointer has no truth value: bool() raises TypeError.
class PtrInt(Ref):
    def __new__(cls, value: int = 0) -> Self: ...
    def __init__(self, value: int = 0) -> None: ...
    @classmethod
    def from_value(cls, value: int) -> PtrInt: ...
    # Go's var p *int.
    @staticmethod
    def nil() -> PtrInt: ...
    # Go's p == nil.
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    value: int

# A List is a Go variable and is never nil; addr() is Go's &v.
class List(Ref):
    def __new__(cls, *, value_: int = 0, next: PtrList = ...) -> List: ...
    def __init__(self, *, value_: int = 0, next: PtrList = ...) -> None: ...
    def addr(self) -> PtrList: ...
    # Go's Value field. "value" is taken by PtrList's *p, so the field gets a
    value_: int
    # A pointer field: may be nil; reading and writing share the list.
    next: PtrList
    def len(self) -> int: ...
    def push(self, v: int) -> PtrList: ...
    def first(self) -> int: ...
    def head(self) -> int: ...

# A *List. Pointer-receiver methods also run on nil, as in Go.
class PtrList(Ref):
    # Go's p := new(List); *p = v.
    def __new__(cls, value: List) -> Self: ...
    def __init__(self, value: List) -> None: ...
    @classmethod
    def from_value(cls, value: List) -> PtrList: ...
    @staticmethod
    def nil() -> PtrList: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    value: List
    value_: int
    next: PtrList
    def len(self) -> int: ...
    def push(self, v: int) -> PtrList: ...
    def first(self) -> int: ...
    def head(self) -> int: ...

def find(l: PtrList, v: int) -> PtrList: ...
def deref(p: PtrInt) -> str: ...
def maybe_int(ok: bool) -> PtrInt: ...
def must_positive(v: int) -> int: ...
