from typing import Never, Self, final
class Ref:
    def __new__(cls, _handle: Never) -> Self: ...
class GoInterface(Ref):
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def as_any(self) -> GoAny: ...
@final
class GoAny(GoInterface):
    @classmethod
    def nil(cls) -> Self: ...
@final
class Counter(GoInterface):
    def __new__(cls, value: Counter) -> Self: ...
    def __init__(self, value: Counter) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    def add(self, arg1: int) -> int: ...
@final
class error(GoInterface):
    def __new__(cls, value: error) -> Self: ...
    def __init__(self, value: error) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    def error(self) -> str: ...
def new(start: int) -> Counter: ...
def echo(value: Counter) -> Counter: ...
def nil() -> Counter: ...
def typed_nil() -> Counter: ...
def result(fail: bool) -> tuple[int,error]: ...
