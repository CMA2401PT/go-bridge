from typing import Generic, Never, Self, TypeVar, final

class Ref:
    def __new__(cls, _handle: Never) -> Self: ...

Target = TypeVar("Target")

class Ptr(Ref, Generic[Target]):
    @property
    def is_nil(self) -> bool: ...

class GoInterface(Ref):
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def as_any(self) -> GoAny: ...

@final
class GoAny(GoInterface):
    @classmethod
    def nil(cls) -> Self: ...

# 接口构造只接受静态方法集满足 Animal 的包装；Cat 值不在其中。
@final
class Animal(GoInterface):
    def __new__(cls, value: Animal | Dog | PtrDog | PtrCat) -> Self: ...
    def __init__(self, value: Animal | Dog | PtrDog | PtrCat) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    def kind(self) -> str: ...
    def speak(self, times: int) -> str: ...

# 结构体包装是可修改的 Go 变量；addr() 指向原变量，装入接口则复制值。
@final
class Dog(Ref):
    def __new__(cls, *, name: str = ...) -> Self: ...
    def __init__(self, *, name: str = ...) -> None: ...
    name: str
    def addr(self) -> PtrDog: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class PtrDog(Ptr[Dog]):
    name: str
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

# Cat 的接口方法采用指针接收者，因此要先 addr() 才能装入 Animal。
@final
class Cat(Ref):
    def __new__(cls, *, name: str = ...) -> Self: ...
    def __init__(self, *, name: str = ...) -> None: ...
    name: str
    def addr(self) -> PtrCat: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class PtrCat(Ptr[Cat]):
    name: str
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

# Go error 保留为接口值，调用者通过 is_nil 决定是否读取消息。
@final
class error(GoInterface):
    def __new__(cls, value: error) -> Self: ...
    def __init__(self, value: error) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    def error(self) -> str: ...

def adopt(kind: str, name: str) -> Animal: ...
def introduce(animal: Animal) -> str: ...
def nobody() -> Animal: ...
def stray() -> Animal: ...
def feed(animal: Animal, food: str) -> tuple[str, error]: ...
