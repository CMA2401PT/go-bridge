from typing import Iterable, SupportsIndex, ClassVar, Never, Self, final
class Ref:
    def __new__(cls, _handle: Never) -> Self: ...
@final
class PtrArray3Int(Ref): ...
@final
class Array3Int(Ref):
    __iter__: ClassVar[None]
    def __new__(cls, values: Iterable[int] = ...) -> Self: ...
    def __init__(self, values: Iterable[int] = ...) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: SupportsIndex) -> int: ...
    def __setitem__(self, index: SupportsIndex, value: int) -> None: ...
    def __copy__(self) -> Array3Int: ...
    def addr(self) -> PtrArray3Int: ...
    def copy_to_py_list(self) -> list[int]: ...
def echo(value: Array3Int) -> Array3Int: ...
def increment(value: Array3Int) -> Array3Int: ...
def mutate(value: PtrArray3Int) -> None: ...
