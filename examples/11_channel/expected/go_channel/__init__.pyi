from typing import Never, Self, final

class Ref:
    def __new__(cls, _handle: Never) -> Self: ...

@final
class ChanInt(Ref):
    def __new__(cls, capacity: int = 0) -> Self: ...
    def __init__(self, capacity: int = 0) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def send(self, value: int) -> None: ...
    def recv(self) -> tuple[int, bool]: ...
    def close(self) -> None: ...
    def send_only(self) -> SendChanInt: ...
    def recv_only(self) -> RecvChanInt: ...
@final
class SendChanInt(Ref):
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def send(self, value: int) -> None: ...
    def close(self) -> None: ...
@final
class RecvChanInt(Ref):
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def recv(self) -> tuple[int, bool]: ...
@final
class ChanString(Ref):
    def __new__(cls, capacity: int = 0) -> Self: ...
    def __init__(self, capacity: int = 0) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def send(self, value: str) -> None: ...
    def recv(self) -> tuple[str, bool]: ...
    def close(self) -> None: ...

def numbers(count: int) -> RecvChanInt: ...
def sum(ch: RecvChanInt) -> int: ...
def send(ch: SendChanInt, value: int) -> None: ...
def echo(ch: ChanInt) -> ChanInt: ...
def echo_text(ch: ChanString) -> ChanString: ...
