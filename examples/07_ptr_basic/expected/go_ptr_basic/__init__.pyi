from typing import ClassVar, Generic, Iterable, Never, Self, TypeVar

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

Target = TypeVar("Target")

# A Go *T. Construction allocates a new variable holding a copy of the value,
# like Go's p := new(T); *p = v. The pointer itself never changes; .value
# reads and writes *p. Distinct pointer types are unrelated classes, as in Go.
class Ptr(Ref, Generic[Target]):
    # Only a concrete subclass for one target type constructs a Ptr.
    def __new__(cls, _handle: Never) -> Ptr[Target]: ...
    value: Target

class PtrInt(Ptr[int]):
    def __new__(cls, value: int = 0) -> Self: ...
    def __init__(self, value: int = 0) -> None: ...
    # Same as the constructor. Python's int has no ptr(), so this is its way in.
    @classmethod
    def from_value(cls, value: int) -> PtrInt: ...

# A named value type: a real int subclass, passed to Go by value. Only
# value-receiver methods; pointer-receiver methods live on its pointer class.
class MyNamedNonStructInt(int):
    def __new__(cls, value: int = 0) -> Self: ...
    def unname(self) -> int: ...
    def echo_non_struct_int(self) -> str: ...
    # A new variable holding a copy of this value; every call allocates.
    def ptr(self) -> PtrMyNamedNonStructInt: ...

class PtrMyNamedNonStructInt(Ptr[MyNamedNonStructInt]):
    def __new__(cls, value: MyNamedNonStructInt = ...) -> Self: ...
    def __init__(self, value: MyNamedNonStructInt = ...) -> None: ...
    @classmethod
    def from_value(cls, value: MyNamedNonStructInt) -> PtrMyNamedNonStructInt: ...
    # The method set of *T includes the value-receiver methods of T.
    def echo_non_struct_int(self) -> str: ...
    def ptr_echo_non_struct_int(self) -> str: ...
    def inc(self) -> None: ...

ElemType = TypeVar("ElemType")

class Slice(Ref, Generic[ElemType]):
    # Only a concrete subclass for one element type constructs a Slice.
    def __new__(cls, _handle: Never) -> Slice[ElemType]: ...
    # Not iterable: read everything at once with copy_to_py_list().
    __iter__: ClassVar[None]
    def __len__(self) -> int: ...
    def copy_to_py_list(self) -> list[ElemType]: ...

class SliceInt(Slice[int]):
    def __new__(cls, values: Iterable[int]) -> Self: ...
    def __init__(self, values: Iterable[int]) -> None: ...
    # A new variable holding this slice header; the array stays shared.
    def ptr(self) -> PtrSliceInt: ...

# A distinct type from SliceInt, as in 06; conversions share the array.
class MyNamedNonStructSliceInt(Slice[int]):
    # Go's MyNamedNonStructSliceInt(s).
    def __new__(cls, values: SliceInt) -> Self: ...
    def __init__(self, values: SliceInt) -> None: ...
    # Go's []int(si).
    def unname(self) -> SliceInt: ...
    def echo_non_struct_slice_int(self) -> str: ...
    def ptr(self) -> PtrMyNamedNonStructSliceInt: ...

# *p is a slice header: reading copies the header, which shares the backing
# array (s := *p); assigning replaces it (*p = s). A header change through
# the pointer, such as append, is not seen by headers read earlier.
class PtrSliceInt(Ptr[SliceInt]):
    def __new__(cls, value: SliceInt) -> Self: ...
    def __init__(self, value: SliceInt) -> None: ...
    @classmethod
    def from_value(cls, value: SliceInt) -> PtrSliceInt: ...

class PtrMyNamedNonStructSliceInt(Ptr[MyNamedNonStructSliceInt]):
    def __new__(cls, value: MyNamedNonStructSliceInt) -> Self: ...
    def __init__(self, value: MyNamedNonStructSliceInt) -> None: ...
    @classmethod
    def from_value(cls, value: MyNamedNonStructSliceInt) -> PtrMyNamedNonStructSliceInt: ...
    def echo_non_struct_slice_int(self) -> str: ...
    def ptr_echo_non_struct_slice_int(self) -> str: ...
    def append(self, v: int) -> None: ...

def fn_echo_non_struct_int(i: MyNamedNonStructInt) -> str: ...
def ptr_fn_echo_non_struct_int(i: PtrMyNamedNonStructInt) -> str: ...
def fn_echo_int(i: int) -> str: ...
def ptr_fn_echo_int(i: PtrInt) -> str: ...
def inc_int(i: PtrInt) -> None: ...
def fn_echo_non_struct_slice_int(si: MyNamedNonStructSliceInt) -> str: ...
def fn_echo_slice_int(si: SliceInt) -> str: ...
def ptr_fn_echo_non_struct_slice_int(si: PtrMyNamedNonStructSliceInt) -> str: ...
def ptr_fn_echo_slice_int(si: PtrSliceInt) -> str: ...
def append_slice_int(si: PtrSliceInt, v: int) -> None: ...
