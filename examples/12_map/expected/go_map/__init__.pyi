from typing import Iterable, Never, Self, ClassVar
class Ref:
    def __new__(cls, handle: Never) -> Self: ...
class MapStringInt(Ref):
    def __new__(cls, items: Iterable[tuple[str, int]] = ()) -> Self: ...
    def __init__(self, items: Iterable[tuple[str, int]] = ()) -> None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: str) -> int: ...
    def __setitem__(self, key: str, value: int) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    __iter__: ClassVar[None]
    def delete(self, key: str) -> None: ...
    def clear(self) -> None: ...
    def clone(self) -> Self: ...
    def copy_to_py_items(self) -> list[tuple[str, int]]: ...
def echo(value: MapStringInt) -> MapStringInt: ...
def put(value: MapStringInt, key: str, item: int) -> None: ...
def nil() -> MapStringInt: ...
