from typing import Never

class Ref:
    # Only concrete Go wrappers construct a Ref; raw addresses are not public.
    def __new__(cls, _handle: Never) -> Ref: ...

class SliceBytes(Ref):
    def __new__(cls, value: bytes) -> SliceBytes: ...
    def __init__(self, value: bytes) -> None: ...
    def __len__(self) -> int: ...
    def copy_to_py_bytes(self) -> bytes: ...

def recv_and_return_bytes(value: SliceBytes) -> SliceBytes: ...
