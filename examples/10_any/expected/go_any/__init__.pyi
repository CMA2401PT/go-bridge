from typing import ClassVar, Generic, Iterable, Never, Self, SupportsIndex, TypeVar, final

class Ref:
    def __new__(cls, _handle: Never) -> Self: ...

Elem = TypeVar("Elem")
Target = TypeVar("Target")

class Slice(Ref, Generic[Elem]):
    __iter__: ClassVar[None]
    def __len__(self) -> int: ...
    def __getitem__(self, index: SupportsIndex) -> Elem: ...
    def __setitem__(self, index: SupportsIndex, value: Elem) -> None: ...
    def copy_to_py_list(self) -> list[Elem]: ...

class Ptr(Ref, Generic[Target]):
    value: Target

class GoInterface(Ref):
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def as_any(self) -> GoAny: ...

@final
class GoAny(GoInterface):
    @classmethod
    def nil(cls) -> Self: ...

@final
class MyInt(int):
    def __new__(cls, value: int = 0) -> Self: ...
    def unname(self) -> int: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class SliceInt(Slice[int]):
    def __new__(cls, values: Iterable[int]) -> Self: ...
    def __init__(self, values: Iterable[int]) -> None: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class MySlice(Slice[int]):
    def __new__(cls, value: SliceInt) -> Self: ...
    def __init__(self, value: SliceInt) -> None: ...
    def unname(self) -> SliceInt: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class Point(Ref):
    def __new__(cls, *, x: int = 0, values: SliceInt = ..., data: GoAny = ...) -> Self: ...
    def __init__(self, *, x: int = 0, values: SliceInt = ..., data: GoAny = ...) -> None: ...
    x: int
    values: SliceInt
    data: GoAny
    def addr(self) -> PtrPoint: ...
    def __copy__(self) -> Self: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...

@final
class PtrInt(Ptr[int]):
    def __new__(cls, value: int = 0) -> Self: ...
    def __init__(self, value: int = 0) -> None: ...
    @classmethod
    def from_value(cls, value: int) -> Self: ...
    def ptr(self) -> PtrPtrInt: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...

@final
class PtrPoint(Ptr[Point]):
    def __new__(cls, value: Point) -> Self: ...
    def __init__(self, value: Point) -> None: ...
    @classmethod
    def from_value(cls, value: Point) -> Self: ...
    x: int
    values: SliceInt
    data: GoAny
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...

@final
class PtrPtrInt(Ptr[PtrInt]):
    def __new__(cls, value: PtrInt) -> Self: ...
    def __init__(self, value: PtrInt) -> None: ...
    @classmethod
    def from_value(cls, value: PtrInt) -> Self: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...

@final
class IntPtr(Ptr[int]):
    def __new__(cls, value: PtrInt) -> Self: ...
    def __init__(self, value: PtrInt) -> None: ...
    def unname(self) -> PtrInt: ...
    def as_any(self) -> GoAny: ...
    @classmethod
    def from_any(cls, value: GoInterface) -> Self: ...
    @classmethod
    def try_from_any(cls, value: GoInterface) -> Self | None: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...

