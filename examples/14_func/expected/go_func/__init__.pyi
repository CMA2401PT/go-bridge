from typing import Self, Never
class FuncIntToInt:
    def __new__(cls, _handle: Never) -> Self: ...
    @classmethod
    def nil(cls) -> Self: ...
    @property
    def is_nil(self) -> bool: ...
    def __bool__(self) -> Never: ...
    def __call__(self, arg1: int) -> int: ...
def counter(start: int) -> FuncIntToInt: ...
def apply(value: FuncIntToInt, delta: int) -> int: ...
def echo(value: FuncIntToInt) -> FuncIntToInt: ...
def nil() -> FuncIntToInt: ...
